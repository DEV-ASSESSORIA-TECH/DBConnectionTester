{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GUILHERME-GARCIATECH/DBConnectionTester/schemas/run-export-manifest-v1.schema.json",
  "title": "DB Connection Tester run ZIP manifest v1",
  "type": "object",
  "required": [
    "formatVersion",
    "runId",
    "createdAt",
    "files"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^run-[0-9a-fA-F-]+\\.(csv|txt|json)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
